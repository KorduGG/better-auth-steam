{
	"name": "better-auth-steam",
	"version": "0.2.1",
	"description": "Steam OpenID 2.0 plugin for Better Auth",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ytsdv/better-auth-steam.git"
	},
	"bugs": {
		"url": "https://github.com/ytsdv/better-auth-steam/issues"
	},
	"homepage": "https://github.com/ytsdv/better-auth-steam#readme",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"better-auth",
		"steam",
		"openid",
		"authentication"
	],
	"scripts": {
		"build": "tsup src/index.ts src/client.ts --dts --format esm --out-dir dist --sourcemap --clean --external better-auth --external zod",
		"lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
		"test": "tsx --test tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run lint && pnpm run test && pnpm run typecheck && pnpm run build"
	},
	"peerDependencies": {
		"better-auth": ">=1.6.21 <2",
		"zod": ">=4"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.9.1",
		"better-auth": "~1.6.29",
		"eslint": "^9.38.0",
		"tsup": "^8.5.0",
		"tsx": "^4.21.0",
		"typescript-eslint": "^8.46.1",
		"typescript": "^6.0.2",
		"zod": "^4.3.6"
	}
}
